@startuml Preciazo_C4_Container
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
title Preciazo - Container Diagram (TB2 / Sprint 4)

Person(buyer, "Independent Buyer", "Plans purchases, compares multi-store prices, manages budgets and generates optimized routes.")
Person(merchant, "Retail Merchant", "Manages store profile, inventory stock/prices, promotions and analytics.")

System_Ext(osrm, "OSRM Routing Service (OpenStreetMap)", "Calculates real urban road distance and travel duration for multi-stop itineraries.")
System_Ext(ruc, "RUC Verification Service", "External fiscal verification contract for merchant validation.")

System_Boundary(preciazo, "Preciazo Platform") {
    Container(landing, "Landing Page", "HTML5, CSS3, JavaScript (i18n en_US/es_419)", "Static marketing site with segment CTAs, embedded videos and Terms of Service.")
    Container(webapp, "Web Application (Angular SPA)", "Angular 22, TypeScript, Angular Material", "Responsive Web App for Buyer and Merchant portals, consuming REST API with JWT Bearer auth.")
    Container(api, "Preciazo RESTful Web Services", "Java 27, Spring Boot 4.1.2, Spring Security JWT", "Modular DDD/CQRS backend exposing 7 Bounded Contexts documented with OpenAPI 3.1.")
    ContainerDb(database, "Relational Database", "MySQL 8.4", "Persists operational tables isolated logically by Bounded Context.")
}

Rel(buyer, landing, "Discovers product & watches videos", "HTTPS")
Rel(merchant, landing, "Discovers product & merchant plans", "HTTPS")
Rel(landing, webapp, "Redirects via segment CTAs (?role=buyer|merchant)", "HTTPS")
Rel(buyer, webapp, "Manages lists, compares prices, verifies & routes", "HTTPS")
Rel(merchant, webapp, "Manages store, inventory, promotions & metrics", "HTTPS")
Rel(webapp, api, "Consumes REST endpoints with Bearer JWT & Accept-Language", "HTTPS / JSON")
Rel(api, database, "Reads and writes via JPA repositories", "JDBC / SQL")
Rel(api, osrm, "Requests multi-stop road distances & durations", "HTTPS / JSON")
Rel(api, ruc, "Validates merchant fiscal status", "HTTPS / JSON")
@enduml
