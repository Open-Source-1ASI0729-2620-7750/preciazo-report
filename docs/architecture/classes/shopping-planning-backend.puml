ShoppingListQueryServiceImpl ..|> ShoppingListQueryService
ShoppingTemplateCommandServiceImpl ..|> ShoppingTemplateCommandService
ShoppingTemplateQueryServiceImpl ..|> ShoppingTemplateQueryService
StorePreferenceCommandServiceImpl ..|> StorePreferenceCommandService
StorePreferenceQueryServiceImpl ..|> StorePreferenceQueryService
ShoppingListCommandServiceImpl ..> ShoppingListRepository
ShoppingListCommandServiceImpl ..> ShoppingTemplateRepository
ShoppingListCommandServiceImpl ..> ShoppingReferenceProvider
ShoppingTemplateCommandServiceImpl ..> ShoppingListRepository
ShoppingTemplateCommandServiceImpl ..> ShoppingTemplateRepository
ShoppingTemplateQueryServiceImpl ..> ShoppingTemplateRepository
StorePreferenceCommandServiceImpl ..> FavoriteStoreRepository
StorePreferenceCommandServiceImpl ..> ShoppingReferenceProvider
StorePreferenceQueryServiceImpl ..> FavoriteStoreRepository
ShoppingListQueryServiceImpl ..> ShoppingListRepository
ShoppingListQueryServiceImpl ..> BudgetStatusView
ShoppingListQueryServiceImpl ..> PurchaseProgressView
ShoppingListRepositoryImpl ..|> ShoppingListRepository
ShoppingListRepositoryImpl ..> ShoppingListPersistenceRepository
ShoppingListRepositoryImpl ..> ShoppingListPersistenceAssembler
ShoppingListPersistenceRepository ..> ShoppingListPersistenceEntity
ShoppingListPersistenceAssembler ..> ShoppingList
ShoppingListPersistenceAssembler ..> ShoppingListPersistenceEntity
ShoppingListPersistenceEntity "1" *-- "0..*" ShoppingListItemPersistenceEntity
ShoppingListPersistenceEntity "1" *-- "0..1" PurchaseBudgetPersistenceEntity
ShoppingTemplateRepositoryImpl ..|> ShoppingTemplateRepository
ShoppingTemplateRepositoryImpl ..> ShoppingTemplatePersistenceRepository
ShoppingTemplateRepositoryImpl ..> ShoppingTemplatePersistenceAssembler
ShoppingTemplatePersistenceRepository ..> ShoppingTemplatePersistenceEntity
ShoppingTemplatePersistenceAssembler ..> ShoppingTemplate
ShoppingTemplatePersistenceAssembler ..> ShoppingTemplatePersistenceEntity
ShoppingTemplatePersistenceEntity "1" *-- "1..*" TemplateItemPersistenceEntity
FavoriteStoreRepositoryImpl ..|> FavoriteStoreRepository
FavoriteStoreRepositoryImpl ..> FavoriteStorePersistenceRepository
