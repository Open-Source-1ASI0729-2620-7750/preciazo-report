@startuml Preciazo_Merchant_Management_Classes
title Preciazo - Merchant Management Domain Classes (AV2)
set namespaceSeparator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
scale max 3200 width
class MerchantProfile <<Aggregate>> {
 -id: Long
 -ownerId: Long
 -taxId: Ruc
 -legalName: String
 -verificationStatus: VerificationStatus
 -verificationCheckedAt: DateTime [0..1]
 -version: Long
 +recordFiscalResult(result: VerificationResult): void
 +canOperate(): Boolean
}
class RetailStore <<Aggregate>> {
 -id: Long
 -merchantProfileId: Long
 -name: String
 -address: Address
 -latitude: Decimal
 -longitude: Decimal
 -timeZone: String
 -scheduleConfigured: Boolean
 -version: Long
 +updateInformation(address: Address): void
 +replaceOpeningHours(hours: List<OpeningWindow>): void
 +openingStatusAt(moment: DateTime): OpeningStatus
}
class OpeningWindow <<Value Object>> {
 -dayOfWeek: Integer {readOnly}
 -opensAt: LocalTime {readOnly}
 -closesAt: LocalTime {readOnly}
 -closesNextDay: Boolean {readOnly}
 +contains(moment: DateTime, timeZone: String): Boolean
}
class InventoryItem <<Aggregate>> {
 -id: Long
 -storeId: Long
 -productId: Long
 -stock: Quantity
 -version: Long
 +setStock(quantity: Quantity): void
 +isPhysicallyAvailable(): Boolean
}
class Promotion <<Aggregate>> {
 -id: Long
 -storeId: Long
 -inventoryItemId: Long
 -catalogEntryId: Long
 -description: String
 -promotionalPrice: Money
 -regularPriceAtCreation: Money
 -saleUnit: String
 -startsAt: DateTime
 -endsAt: DateTime
 -status: PromotionStatus
 -version: Long
 +updateBeforeStart(price: Money, startsAt: DateTime, endsAt: DateTime): void
 +activate(at: DateTime): void
 +expire(at: DateTime): void
 +cancel(): void
 +isEffectiveAt(at: DateTime, currentRegularPrice: Money): Boolean
}
class InventoryImportBatch <<Aggregate>> {
 -id: Long
 -storeId: Long
 -requestedBy: Long
 -idempotencyKey: String
 -requestHash: String
 -createdAt: DateTime
 -appliedAt: DateTime [0..1]
 -status: ImportStatus
 +validateRows(): List<ImportRowError>
 +markApplied(): void
 +markFailed(): void
}
class InventoryImportRow {
 -rowNumber: Integer
 -productId: Long
 -stock: Quantity
 -proposedPrice: Money [0..1]
}
class VerificationResult <<Value Object>> {
 -taxId: Ruc {readOnly}
 -legalName: String [0..1] {readOnly}
 -fiscalStatus: FiscalStatus {readOnly}
 -checkedAt: DateTime {readOnly}
}
class ImportRowError <<Value Object>> {
 -rowNumber: Integer {readOnly}
 -field: String {readOnly}
 -code: String {readOnly}
}
enum VerificationStatus {
 PENDING
 VERIFIED
 REJECTED
}
enum FiscalStatus {
 ACTIVE
 INACTIVE
 NOT_FOUND
}
enum OpeningStatus {
 OPEN
 CLOSED
 UNKNOWN
}
enum PromotionStatus {
 SCHEDULED
 ACTIVE
 EXPIRED
 CANCELLED
}
enum ImportStatus {
 VALIDATED
 APPLIED
 FAILED
}
class Money <<Value Object>> {
    -amount: Decimal {readOnly}
    -currency: String {readOnly}
    +add(other: Money): Money
    +subtract(other: Money): Money
    +multiply(factor: Decimal): Money
    +isLessThan(other: Money): Boolean
    +isGreaterThan(other: Money): Boolean
    +isDifferentFrom(other: Money): Boolean
    +isPositive(): Boolean
}

class Quantity <<Value Object>> {
    -amount: Decimal {readOnly}
    -unit: String {readOnly}
    +add(other: Quantity): Quantity
    +subtract(other: Quantity): Quantity
    +isPositive(): Boolean
}

class Ruc <<Value Object>> {
    -value: String {readOnly}
    +equals(other: Ruc): Boolean
}

class Address <<Value Object>> {
    -street: String {readOnly}
    -district: String {readOnly}
    -province: String {readOnly}
    -department: String {readOnly}
    +equals(other: Address): Boolean
}
MerchantProfile "1" --> "1" Ruc
MerchantProfile ..> VerificationStatus
MerchantProfile ..> VerificationResult
VerificationResult ..> FiscalStatus
RetailStore "1" --> "1" Address
RetailStore "1" *-- "0..*" OpeningWindow
RetailStore ..> OpeningStatus
InventoryItem "1" --> "1" Quantity : physical stock
Promotion "1" --> "1" Money : promotional price
Promotion ..> PromotionStatus
InventoryImportBatch "1" *-- "1..*" InventoryImportRow
InventoryImportRow "1" --> "1" Quantity
InventoryImportRow "1" --> "0..1" Money : proposed price input
InventoryImportBatch ..> ImportStatus
InventoryImportBatch ..> ImportRowError
note bottom of MerchantProfile
 RUC has exactly 11 digits; format is not fiscal verification.
 ACTIVE fiscal result -> VERIFIED; INACTIVE / NOT_FOUND -> REJECTED.
 Provider timeout or failure keeps PENDING, never REJECTED.
 Ownership proof remains distinct from fiscal validation.
end note
note bottom of RetailStore
 Store time zone defaults to America/Lima.
 Opening windows cannot overlap, including across midnight.
 No configured hours -> UNKNOWN; missing weekdays are CLOSED.
 Open/closed is calculated on query, not a timer-generated event.
end note
note bottom of InventoryItem
 Quantity >= 0 with a compatible unit; no second public price.
 Catalog owns published price and availability.
 Physical inventory changes do not claim automatic catalog synchronization.
end note
note bottom of Promotion
 Promotional price > 0, same currency and sale unit as the offer reference.
 The discount is checked against trusted current regular price.
 Public validity is startsAt <= now < endsAt and not CANCELLED / EXPIRED.
 Queries exclude ended promotions even if a scheduled job runs late.
 Expiry falls back to current catalog base price, never the frozen old price.
end note
note bottom of InventoryImportBatch
 Validate every row before changing inventory.
 Duplicate products, blank fields or invalid numbers reject the whole batch.
 A price-bearing batch cannot be APPLIED without coordinated Catalog changes.
 Proposed row prices are input/audit data, not canonical public prices.
end note
MerchantProfile -[hidden]down-> RetailStore
RetailStore -[hidden]down-> InventoryItem
InventoryItem -[hidden]down-> Promotion
@enduml
