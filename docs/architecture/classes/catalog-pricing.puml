@startuml Preciazo_Catalog_Pricing_Classes
title Preciazo - Catalog and Pricing Domain Classes (AV2)
set namespaceSeparator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
scale max 3200 width

 class Product <<Aggregate>> {
  -id: Long
  -name: String
  -brand: String
  -category: String
  -saleUnit: String
  -netContent: Quantity [0..1]
  -substituteProductIds: Set<Long>
  +defineSubstitute(productId: Long): void
 }
 class StoreProduct <<Aggregate>> {
  -id: Long
  -productId: Long
  -store: RetailStoreRef
  -sellingPrice: Money
  -stockStatus: StockStatus
  -updatedAt: DateTime
  -version: Long
  +changeSellingPrice(price: Money): void
  +updateAvailability(status: StockStatus): void
  +isAvailable(): Boolean
 }
 class PriceSnapshot {
  -id: Long
  -sellingPrice: Money
  -saleUnit: String
  -netContent: Quantity [0..1]
  -capturedAt: DateTime
 }
 class CatalogStoreReference <<Aggregate>> {
  -id: Long
  -storeId: Long
  -ownerId: Long
  -district: String
  -location: GeoPoint
  -affiliated: Boolean
  -capturedAt: DateTime
  -sourceVersion: Long
  +isOwnedBy(userId: Long): Boolean
 }
 class GeoPoint <<Value Object>> {
  -latitude: Decimal {readOnly}
  -longitude: Decimal {readOnly}
  +distanceMetersTo(other: GeoPoint): Decimal
 }
 class RetailStoreRef <<Value Object>> {
  -storeId: Long {readOnly}
 }
 interface PriceComparisonPolicy <<domain policy>> {
  +totalFor(items: List<BasketItem>, offers: List<StoreProduct>): Optional<Money>
  +normalize(price: Money, content: Quantity): Optional<UnitPrice>
 }
 class BasketItem <<Value Object>> {
  -productId: Long {readOnly}
  -quantity: Quantity {readOnly}
 }
 enum StockStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
 }
class Money <<Value Object>> {
    -amount: Decimal {readOnly}
    -currency: String {readOnly}
    +add(other: Money): Money
    +subtract(other: Money): Money
    +multiply(factor: Decimal): Money
    +isLessThan(other: Money): Boolean
    +isGreaterThan(other: Money): Boolean
    +isDifferentFrom(other: Money): Boolean
    +isPositive(): Boolean
}

note right of Money
  Immutable; equality by amount and currency.
  Arithmetic and comparisons require the same currency.
  Operations return new values.
end note

class Quantity <<Value Object>> {
    -amount: Decimal {readOnly}
    -unit: String {readOnly}
    +add(other: Quantity): Quantity
    +subtract(other: Quantity): Quantity
    +isPositive(): Boolean
}

note right of Quantity
  Immutable; amount >= 0; unit is not blank.
  Equality by amount and unit; arithmetic requires the same unit.
  Subtraction cannot produce a negative amount.
  Requested purchase quantities must be positive.
end note

class UnitPrice <<Value Object>> {
    -price: Money {readOnly}
    -perUnit: Quantity {readOnly}
    +costFor(quantity: Quantity): Money
    +isLessThan(other: UnitPrice): Boolean
}

note right of UnitPrice
  Immutable; equality by price and perUnit.
  Price >= 0; perUnit amount > 0.
  Cost and comparisons require compatible units
  and the same currency.
end note

UnitPrice "1" --> "1" Money : monetary value
UnitPrice "1" --> "1" Quantity : priced quantity


 Product "1" --> "0..1" Quantity : net content
 StoreProduct "1" *-- "1..*" PriceSnapshot : price history
 StoreProduct "*" --> "1" RetailStoreRef
 StoreProduct "1" --> "1" Money : selling price
 StoreProduct ..> StockStatus
 BasketItem "1" --> "1" Quantity
 note bottom of StoreProduct
  Canonical published selling price and availability live here.
  Price > 0; one offer per store and product.
  Creation and each actual price change save a snapshot in the same transaction.
  Same price: no duplicate snapshot or Price Changed event.
 end note
 note bottom of Product
  netContent is optional; if supplied, quantity is positive and unit is known.
  Missing content -> no normalized kg/litre value; retain shelf price.
  Substitutes are explicitly defined, never inferred from category alone.
 end note

StoreProduct ..> Product : product identifier
CatalogStoreReference "1" --> "1" GeoPoint : location
PriceComparisonPolicy ..> StoreProduct : evaluates
PriceComparisonPolicy ..> UnitPrice : normalizes
PriceComparisonPolicy ..> BasketItem : requested quantities
Product -[hidden]down-> StoreProduct
StoreProduct -[hidden]down-> CatalogStoreReference
@enduml
