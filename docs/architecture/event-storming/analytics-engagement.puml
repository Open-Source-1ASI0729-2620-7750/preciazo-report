@startuml Preciazo_Event_Storming_analytics_engagement
top to bottom direction
title Preciazo - Design-Level Event Storming: Analytics and Engagement (AV2 - US27)
skinparam shadowing false
skinparam defaultFontSize 15
skinparam defaultTextAlignment center
skinparam nodesep 28
skinparam ranksep 28
skinparam rectanglePadding 12
rectangle "Visible Promotion\nEffective offer and interaction control" as read0 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer <<Actor>> #FFE08A
rectangle "Record Promotion Interaction" as cmd0 <<Command>> #ACDAFA
rectangle "Metric Event" as agg0 <<Aggregate>> #FFF1AE
rectangle "Metric Event Recorded" as evt0 <<Domain Event>> #FFD0A1
read0 -right-> buyer
buyer -right-> cmd0
cmd0 -right-> agg0
agg0 -right-> evt0
rectangle "Observed Monthly Metrics\nRoute appearances, distinct promotion users, coverage" as read1 <<Read Model>> #B3EDBE
rectangle "Merchant" as merchant <<Actor>> #FFE08A
rectangle "Generate Merchant Report" as cmd1 <<Command>> #ACDAFA
rectangle "Merchant Report" as agg1 <<Aggregate>> #FFF1AE
rectangle "Merchant Report Generated" as evt1 <<Domain Event>> #FFD0A1
read1 -right-> merchant
merchant -right-> cmd1
cmd1 -right-> agg1
agg1 -right-> evt1
read0 -[hidden]down-> read1
buyer -[hidden]down-> merchant
cmd0 -[hidden]down-> cmd1
agg0 -[hidden]down-> agg1
evt0 -[hidden]down-> evt1
rectangle "Saved Route Optimization\nTrusted source contract; delivery not implemented" as fact <<External Fact>> #FFB2DF
rectangle "Track Selected Stores\nOne observation per store and route version" as policy <<Policy>> #D4BFFA
rectangle "Record Route Stop Suggestion" as cmd2 <<Internal Command>> #ACDAFA
rectangle "Metric Event" as agg2 <<Aggregate>> #FFF1AE
rectangle "Metric Event Recorded" as evt2 <<Domain Event>> #FFD0A1
fact -right-> policy
policy -right-> cmd2
cmd2 -right-> agg2
agg2 -right-> evt2
read1 -[hidden]down-> fact
merchant -[hidden]down-> policy
cmd1 -[hidden]down-> cmd2
agg1 -[hidden]down-> agg2
evt1 -[hidden]down-> evt2
rectangle "Merchant" as reader <<Actor>> #FFE08A
rectangle "Get Store / Promotion Monthly Metrics\nGet Saved Merchant Report" as query <<Query>> #B3EDBE
rectangle "Owner-only Dashboard or Saved Report\nObserved counts and evaluation time" as view <<Read Model>> #B3EDBE
reader -right-> query
query -right-> view
fact -[hidden]down-> reader
rectangle "No success event for retries, queries or failed writes.\nDistinct users are not page views, purchases or physical visits.\nA report freezes observed counts; live queries may include later observations." as rule <<Business Rule>> #FFF1AE
rectangle "Define trusted source delivery, provisioning, retention and abuse controls.\nUNKNOWN coverage: an empty stream does not prove zero real-world activity.\nNo ACL, automatic cross-context subscription or invented engagement formula." as hotspot <<Hotspot>> #FFB7AB
reader -[hidden]down-> rule
rule -[hidden]down-> hotspot
@enduml
