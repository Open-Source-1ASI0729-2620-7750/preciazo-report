@startuml Preciazo_Event_Storming_shopping_planning
top to bottom direction

title
Preciazo - Design-Level Event Storming: Shopping Planning
AV2 Design Proposal - US08-US12
end title
skinparam shadowing false
skinparam defaultFontSize 15
skinparam defaultTextAlignment center
skinparam nodesep 30
skinparam ranksep 30
skinparam rectanglePadding 12

rectangle "Saved Shopping Lists\nLists owned by the buyer" as read0 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer0 <<Actor>> #FFE08A
rectangle "Create Shopping List\nUse date/time when name is omitted" as command0 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate0 <<Aggregate>> #FFF1AE
rectangle "Shopping List Created" as event0 <<Domain Event>> #FFD0A1
read0 -right-> buyer0
buyer0 -right-> command0
command0 -right-> aggregate0
aggregate0 -right-> event0

rectangle "Active Shopping List\nItems and projected total" as read1 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer1 <<Actor>> #FFE08A
rectangle "Add Shopping Item\nIncrease quantity if product already exists" as command1 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate1 <<Aggregate>> #FFF1AE
rectangle "Shopping Item Added" as event1 <<Domain Event>> #FFD0A1
read1 -right-> buyer1
buyer1 -right-> command1
command1 -right-> aggregate1
aggregate1 -right-> event1

rectangle "Active Shopping List\nItems and projected total" as read2 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer2 <<Actor>> #FFE08A
rectangle "Remove Shopping Item" as command2 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate2 <<Aggregate>> #FFF1AE
rectangle "Shopping Item Removed" as event2 <<Domain Event>> #FFD0A1
read2 -right-> buyer2
buyer2 -right-> command2
command2 -right-> aggregate2
aggregate2 -right-> event2

rectangle "Active Shopping List\nItems and projected total" as read3 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer3 <<Actor>> #FFE08A
rectangle "Reduce Shopping Item Quantity" as command3 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate3 <<Aggregate>> #FFF1AE
rectangle "Shopping Item Quantity Reduced" as event3 <<Domain Event>> #FFD0A1
read3 -right-> buyer3
buyer3 -right-> command3
command3 -right-> aggregate3
aggregate3 -right-> event3

rectangle "Budget Status\nLimit and projected total\nWarning when total > limit\nClear when total <= limit\nRequery after add / remove / reduce item\nor set / change budget\nCalculated on query; not a persisted event" as read4 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer4 <<Actor>> #FFE08A
rectangle "Set Purchase Budget\nDefine or change a positive limit" as command4 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate4 <<Aggregate>> #FFF1AE
rectangle "Purchase Budget Set" as event4 <<Domain Event>> #FFD0A1
read4 -right-> buyer4
buyer4 -right-> command4
command4 -right-> aggregate4
aggregate4 -right-> event4

rectangle "Purchase Progress\nPurchased items and checkout total\nMarking includes the item subtotal" as read5 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer5 <<Actor>> #FFE08A
rectangle "Mark Item as Purchased" as command5 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate5 <<Aggregate>> #FFF1AE
rectangle "Shopping Item Marked as Purchased" as event5 <<Domain Event>> #FFD0A1
read5 -right-> buyer5
buyer5 -right-> command5
command5 -right-> aggregate5
aggregate5 -right-> event5

rectangle "Purchase Progress\nPurchased items and checkout total\nUnmarking excludes the item subtotal" as read6 <<Read Model>> #B3EDBE
rectangle "Buyer" as buyer6 <<Actor>> #FFE08A
rectangle "Unmark Item as Purchased" as command6 <<Command>> #ACDAFA
rectangle "Shopping List" as aggregate6 <<Aggregate>> #FFF1AE
rectangle "Shopping Item Unmarked as Purchased" as event6 <<Domain Event>> #FFD0A1
read6 -right-> buyer6
buyer6 -right-> command6
command6 -right-> aggregate6
aggregate6 -right-> event6

' Keep corresponding columns aligned and rows ordered from top to bottom.
read0 -[hidden]down-> read1
buyer0 -[hidden]down-> buyer1
command0 -[hidden]down-> command1
aggregate0 -[hidden]down-> aggregate1
event0 -[hidden]down-> event1
read1 -[hidden]down-> read2
buyer1 -[hidden]down-> buyer2
command1 -[hidden]down-> command2
aggregate1 -[hidden]down-> aggregate2
event1 -[hidden]down-> event2
read2 -[hidden]down-> read3
buyer2 -[hidden]down-> buyer3
command2 -[hidden]down-> command3
aggregate2 -[hidden]down-> aggregate3
event2 -[hidden]down-> event3
read3 -[hidden]down-> read4
buyer3 -[hidden]down-> buyer4
command3 -[hidden]down-> command4
aggregate3 -[hidden]down-> aggregate4
event3 -[hidden]down-> event4
read4 -[hidden]down-> read5
buyer4 -[hidden]down-> buyer5
command4 -[hidden]down-> command5
aggregate4 -[hidden]down-> aggregate5
event4 -[hidden]down-> event5
read5 -[hidden]down-> read6
buyer5 -[hidden]down-> buyer6
command5 -[hidden]down-> command6
aggregate5 -[hidden]down-> aggregate6
event5 -[hidden]down-> event6

@enduml
