@startuml Preciazo_C4_Context
!include <C4/C4_Context>
LAYOUT_LEFT_RIGHT()
title Preciazo - System Context (AV2 Design Proposal)
Person(buyer, "Independent Buyer", "Plans purchases, compares prices, follows routes and contributes price observations.")
Person(merchant, "Retail Merchant", "Manages owned stores, public price offers, inventory, promotions and observed performance metrics.")
System(preciazo, "Preciazo", "Web platform for purchase planning, price comparison, multi-stop routes and merchant operations.")
System_Ext(routing, "Mapping & Routing Service", "Provides travel distances, durations and reachability for the requested mode. Provider selection remains pending.")
System_Ext(ruc, "RUC Verification Service", "Provides fiscal status. Provider selection and ownership proof remain pending.")
System_Ext(securityCheck, "Security Check Provider (pending)", "Required proof verification after login lockout. Provider and protocol are not yet specified.")
Rel(buyer, preciazo, "Plans purchases and contributes observations", "HTTPS")
Rel(merchant, preciazo, "Manages own stores and consults metrics", "HTTPS")
Rel(preciazo, routing, "Requests travel estimates; Preciazo chooses stop order", "HTTPS / API contract pending")
Rel(preciazo, ruc, "Requests fiscal verification, not ownership certification", "HTTPS / API contract pending")
Rel(preciazo, securityCheck, "Verifies required sign-in proof; integration pending", "Protocol pending")
@enduml
