    source : VARCHAR
    source_key : VARCHAR
    payload_fingerprint : VARCHAR
    actor_id : BIGINT <<REF, NULLABLE>>
    promotion_id : BIGINT <<REF, NULLABLE>>
    route_id : BIGINT <<REF, NULLABLE>>
    route_version : BIGINT <<NULLABLE>>
    occurred_at : TIMESTAMP
    received_at : TIMESTAMP
}

entity merchant_reports {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    requested_by : BIGINT <<REF>>
    request_key : VARCHAR
    month : VARCHAR
    time_zone : VARCHAR
    period_from : TIMESTAMP
    period_to : TIMESTAMP
    route_suggestion_count : BIGINT
    distinct_promotion_users : BIGINT
    ingestion_coverage : VARCHAR
