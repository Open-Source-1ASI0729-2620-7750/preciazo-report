    reference_basket_total : DECIMAL <<NULLABLE>>
    gross_savings : DECIMAL <<NULLABLE>>
    transit_cost : DECIMAL <<NULLABLE>>
    net_savings : DECIMAL <<NULLABLE>>
    currency : VARCHAR <<NULLABLE>>
