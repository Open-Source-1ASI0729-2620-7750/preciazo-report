}

entity merchant_report_promotions {
    * id : BIGINT <<PK>>
    --
    report_id : BIGINT <<FK>>
    promotion_id : BIGINT <<REF>>
    interaction_count : BIGINT
    distinct_user_count : BIGINT
}

users ||--o{ user_roles
roles ||--o{ user_roles
roles ||--o{ role_permissions
permissions ||--o{ role_permissions
users ||--o{ auth_sessions
users ||--o| merchant_profiles
merchant_profiles ||--o{ retail_stores
retail_stores ||--o{ inventory_items
products ||--o{ inventory_items
retail_stores ||--o{ catalog_entries
products ||--o{ catalog_entries
catalog_entries ||--|{ price_snapshots
users ||--o{ shopping_lists
shopping_lists ||--o{ shopping_list_members
users ||--o{ shopping_list_members
shopping_lists ||--o{ shopping_list_items
products ||--o{ shopping_list_items
shopping_lists ||--o| purchase_budgets
users ||--o{ routes
shopping_lists |o--o{ routes
routes ||--|{ route_stops
retail_stores ||--o{ route_stops
inventory_items ||--o{ promotions
catalog_entries ||--o{ price_observations
price_discrepancies ||--|{ price_observations
users ||--o{ price_observations
catalog_entries ||--o{ price_discrepancies
users ||--o{ price_discrepancies
price_discrepancies ||--o{ verification_votes
users ||--o{ verification_votes
users ||--o| trust_profiles
retail_stores ||--o{ merchant_reports

note right of merchant_profiles
  One merchant profile per user.
  UNIQUE(user_id)
end note

note right of permissions
  UNIQUE(resource, action)
end note

note right of catalog_entries
  UNIQUE(store_id, product_id).
  Canonical public selling price and stock_status; sale_price > 0.
  Price and history update together; version supports optimistic concurrency.
  Store identity belongs to Merchant Management.
end note

note right of shopping_list_members
  user_id belongs to
  Identity and Access.
end note

note right of inventory_items
  product_id belongs to Catalog and Pricing.
  stock >= 0; stock_unit is required; UNIQUE(store_id, product_id).
  Inventory stores physical quantities, not another public price/status.
  Published selling price and availability belong to catalog_entries.
  Coordination with Catalog is pending; no automatic synchronization is assumed.
end note

note right of purchase_budgets
  UNIQUE(shopping_list_id): one optional budget per list.
  amount > 0; currency matches shopping_lists.currency.
  Changing the budget updates its limit; invalid input is rejected.
  Totals and budget warnings are derived on query, not stored.
  Warning: defined limit AND projected total > limit.
  Clear warning at or below the limit; no warning event is stored.
end note

note right of route_stops
  UNIQUE(route_id, sequence); UNIQUE(route_id, store_id).
  Sequence starts at 1 and is contiguous; at least one selected store.
  Nonnegative leg distances/durations; totals equal the sum of route legs.
  ETA includes travel only, not shopping time or waiting.
  store_id references Merchant Management by identity.
end note


note bottom of shopping_list_items
  UNIQUE(shopping_list_id, product_id).
  Adding an existing product increases quantity without a duplicate.
  quantity > 0; price_per_quantity > 0; estimated_unit_price >= 0.
  Quantity and price units must be compatible; price currency matches the list.
  Subtotal = estimated_unit_price * quantity / price_per_quantity
  after converting quantity to price_per_unit.
  Projected total sums all subtotals; checkout total sums purchased items only.
  Unmarking sets purchased = false and reduces checkout total on the next query.
end note

note right of verification_votes
  UNIQUE(discrepancy_id, voter_id).
  vote_type is CONFIRM or REJECT; immutable after submission.
  Proposed: voter differs from reporter; report must be OPEN.
  Duplicate votes do not produce another vote event.
end note

note right of price_discrepancies
  US28: status is OPEN, UNDER_REVIEW, ACCEPTED or REJECTED.
  Anomalous or unchecked reports are retained as UNDER_REVIEW.
  Initial anomaly screening completes in the report transaction.
  version supports optimistic concurrency; terminal states do not reopen.
  confidence_score remains unset until a confidence rule is configured.
  Formula and acceptance/rejection thresholds are pending decisions.
  TS07: index (reporter_id, catalog_entry_id, reported_at).
  Reject a repeat report within 60 seconds; enforce atomically per buyer/offer.
  A time-window check is not a permanent UNIQUE(buyer, offer) constraint.
end note

note bottom of price_observations
  At least one observation per discrepancy.
  Nonnegative prices; expected and observed prices use the same currency.
  The observation belongs to the discrepancy's catalog offer.
end note

entity discrepancy_reviews {
    * id : BIGINT <<PK>>
    --
    discrepancy_id : BIGINT <<FK, UQ>>
    reviewer_id : BIGINT <<REF>>
    decision : VARCHAR
    reason : VARCHAR
    reviewed_at : TIMESTAMP
}

entity processed_verification_events {
    * id : BIGINT <<PK>>
    --
    event_id : VARCHAR
    handler_name : VARCHAR
    discrepancy_id : BIGINT <<FK>>
    processed_at : TIMESTAMP
}

price_discrepancies ||--o| discrepancy_reviews
price_discrepancies ||--o{ processed_verification_events

note right of discrepancy_reviews
  One final human review per report; decision is ACCEPT or REJECT.
  Reviewer requires price-reports:resolve; reason is mandatory.
  Report must be UNDER_REVIEW; review and status change are atomic.
  reviewer_id references Identity and Access by identifier only.
end note

note right of processed_verification_events
  UNIQUE(event_id, handler_name).
  Marker and domain mutation commit together or roll back together.
  Domain event identity is distinct from the generated BIGINT row id.
end note

entity product_substitutions {
    * product_id : BIGINT <<PK, FK>>
    * substitute_product_id : BIGINT <<PK, FK>>
}

entity catalog_store_references {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<REF, UQ>>
    owner_id : BIGINT <<REF>>
    district : VARCHAR
    latitude : DECIMAL
    longitude : DECIMAL
    affiliated : BOOLEAN
    captured_at : TIMESTAMP
    source_version : BIGINT
}

products ||--o{ product_substitutions : original product
products ||--o{ product_substitutions : substitute product

note bottom of products
  sale_unit is the requested purchase unit for basket quantities.
  net_content_quantity and net_content_unit are both present or both absent.
  Present net content is positive; supported units allow mass/volume conversion.
  No content -> normalized price is unavailable, never zero.
end note

note bottom of product_substitutions
  UNIQUE(product_id, substitute_product_id); product_id != substitute_product_id.
  Explicit directional candidates; compatibility is checked before comparison.
end note

note bottom of price_snapshots
  Initial snapshot and actual price changes are saved with the offer atomically.
  sale_price > 0; currency, sale unit and net content are historical snapshots.
  Index (catalog_entry_id, captured_at, id); no fabricated daily samples.
end note

note right of catalog_store_references
  Local reference data for ownership, affiliation, district and proximity.
  Coordinates and owner refer to a store by identifiers only.
  Trusted internal refresh uses increasing source_version.
  Provisioning and refresh guarantees remain pending; no ACL is introduced.
end note

entity store_opening_hours {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    day_of_week : SMALLINT
    opens_at : TIME
    closes_at : TIME
    closes_next_day : BOOLEAN
}

entity inventory_import_batches {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    requested_by : BIGINT <<REF>>
    idempotency_key : VARCHAR
    request_hash : VARCHAR
    status : VARCHAR
    created_at : TIMESTAMP
    applied_at : TIMESTAMP <<NULLABLE>>
}

entity inventory_import_rows {
    * id : BIGINT <<PK>>
    --
    batch_id : BIGINT <<FK>>
    row_number : INTEGER
    product_id : BIGINT <<REF>>
    stock : DECIMAL
    stock_unit : VARCHAR
    proposed_price : DECIMAL <<NULLABLE>>
    price_currency : VARCHAR <<NULLABLE>>
}

retail_stores ||--o{ store_opening_hours
retail_stores ||--o{ inventory_import_batches
inventory_import_batches ||--|{ inventory_import_rows
retail_stores ||--o{ promotions

note right of store_opening_hours
  Day is 1..7; no rows means UNKNOWN if no schedule was configured.
  An explicitly configured empty week means CLOSED.
  Store schedule_configured flag distinguishes those cases.
  Windows last more than 0 and at most 24 hours; equal endpoints need next-day closure.
  Windows cannot overlap, including the following day for overnight windows.
  Opens/closed is a query in the store time zone; no stored open-now flag.
end note

note right of promotions
  promotional_price > 0; ends_at > starts_at; same currency and sale unit.
  status: SCHEDULED, ACTIVE, EXPIRED or CANCELLED.
  Effective only while starts_at <= now < ends_at and not cancelled/expired.
  Frozen regular_price_at_creation is audit data, not a public base price.
  Expiry falls back to the current Catalog price; no base-price overwrite.
  Overlapping promotions on the same catalog offer are rejected atomically.
end note

note right of inventory_import_batches
  UNIQUE(store_id, idempotency_key); same key + different request hash -> conflict.
  Validate all rows before writes; apply all supported changes or none.
  A price-bearing batch requires coordinated Catalog writes before APPLIED.
  Missing coordination -> unavailable; no partial stock-only success.
end note

note bottom of inventory_import_rows
  UNIQUE(batch_id, row_number); duplicate product rows reject the batch.
  stock >= 0; compatible unit; proposed_price is positive if supplied.
  proposed_price and price_currency are supplied together or both absent.
  Proposed prices are input/audit data, never a competing catalog price.
end note

entity route_items {
    * id : BIGINT <<PK>>
    --
    route_id : BIGINT <<FK>>
    product_id : BIGINT <<REF>>
    quantity : DECIMAL
    quantity_unit : VARCHAR
    assigned_stop_id : BIGINT <<FK, NULLABLE>>
    catalog_entry_id : BIGINT <<REF, NULLABLE>>
    estimated_price : DECIMAL <<NULLABLE>>
    price_currency : VARCHAR <<NULLABLE>>
    price_per_quantity : DECIMAL <<NULLABLE>>
    price_per_unit : VARCHAR <<NULLABLE>>
}

routes ||--o{ route_items
route_stops |o--o{ route_items : optional assignment

note bottom of route_items
  UNIQUE(route_id, product_id); quantity > 0 with a compatible unit.
  Assigned stop must belong to the same route; offer must match product and store.
  Missing assignment/price is explicit, not a zero-cost item.
  Unassigned required items -> INCOMPLETE coverage; confirmation is blocked.
end note

note right of routes
  Owner is authenticated; optional list must belong to that owner.
  Coverage is COMPLETE, INCOMPLETE or NOT_EVALUATED.
  No list -> no basket coverage or savings claim.
  Missing comparable baseline or transit cost -> no net_savings value.
  Money fields share currency; negative savings are permitted.
  Origin -> selected stops; no implicit return-to-origin leg.
  Save route, stops and items atomically with optimistic version control.
  A failed recalculation preserves the previous route and version.
end note




retail_stores ||--o{ analytics_events
merchant_reports ||--o{ merchant_report_promotions

note right of analytics_events
  UNIQUE(source, source_key, event_type, store_id); immutable observations.
  Index (store_id, occurred_at); index (promotion_id, occurred_at, actor_id).
  ROUTE_STOP_SUGGESTED requires route_id + route_version and no promotion_id.
  PROMOTION_INTERACTED requires promotion_id + actor_id and no route fields.
  Source identities are server-scoped; duplicate payload mismatch -> conflict.
  received_at is server time; occurred_at is trusted and not in the future.
  Required source/store/promotion references must be validated before acceptance.
end note

note right of merchant_reports
  UNIQUE(store_id, request_key); owner checked before creation and retrieval.
  Month uses store time zone: period_from <= occurred_at < period_to.
  period_from < period_to; counts >= 0; coverage remains UNKNOWN.
  Frozen report and detail rows saved atomically from one consistent snapshot.
  Live metrics may change after late observations; saved reports do not.
  No merchant_metrics table: read models aggregate accepted observations.
end note

note bottom of merchant_report_promotions
  UNIQUE(report_id, promotion_id); counts >= 0.
  distinct_user_count <= interaction_count; promotion belongs to report store.
  Store-level distinct users cannot be obtained by summing detail counts.
end note

@enduml
