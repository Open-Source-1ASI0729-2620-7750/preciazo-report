    --
    email : VARCHAR <<UQ>>
    status : VARCHAR
}

entity roles {
    * id : BIGINT <<PK>>
    --
    name : VARCHAR <<UQ>>
}

entity permissions {
    * id : BIGINT <<PK>>
    --
    resource : VARCHAR
    action : VARCHAR
}

entity user_roles {
    * user_id : BIGINT <<PK, FK>>
    * role_id : BIGINT <<PK, FK>>
}

entity role_permissions {
    * role_id : BIGINT <<PK, FK>>
